# ==============================================================================
# Work Reporter - Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key for encrypting Flask session cookies (generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Single login password for accessing the web app
APP_PASSWORD=YourStrongAppPasswordHere

# Secret token for authenticating external cron ticks: GET /cron/tick?key=YOUR_CRON_SECRET
CRON_SECRET=replace-with-a-random-secret-token

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string in production (e.g., postgresql://user:pass@ep-xyz.aws.neon.tech/workreporter?sslmode=require)
# Leave empty or omit for local development to use local SQLite (work_reporter.db)
DATABASE_URL=


# ------------------------------------------------------------------------------
# Timezone & Scheduling
# ------------------------------------------------------------------------------
# Timezone for date calculation, deadlines, and cron checks (IANA timezone name)
TIMEZONE=Asia/Kolkata

# Day of the week to send the weekly Excel report: 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday
REPORT_DAY=4

# Time to send the weekly report in 24-hour HH:MM format (default: 17:00 / 5:00 PM)
REPORT_TIME=17:00

# Time to send the daily schedule for tomorrow at night (24-hour HH:MM format, default: 18:00 / 6:00 PM)
# E.g., Sunday 6pm sends Monday's schedule, Monday 6pm sends Tuesday's schedule
SCHEDULE_TIME=18:00

# ------------------------------------------------------------------------------
# Email Recipient Settings
# ------------------------------------------------------------------------------
# Manager's email address (receives weekly report and daily schedule screenshot)
MANAGER_EMAIL=manager@example.com

# Your email address (receives CCs, missing note warnings, and upload reminders; also set as Reply-To)
OWNER_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Google Gemini API (Free Tier)
# ------------------------------------------------------------------------------
# Google AI Studio API key (optional). If missing or failing, the app falls back to an intelligent rule-based parser
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Live Cloud Excel / Google Sheets Sync (Optional)
# ------------------------------------------------------------------------------
# If set, the app automatically fetches and syncs latest classes from Google Sheets or OneDrive before sending
# E.g. https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit?usp=sharing
TIMETABLE_EXCEL_URL=

# ------------------------------------------------------------------------------
# HTTPS Email Relays (Bypasses Render Free Tier SMTP [Errno 101] Network is unreachable)
# ------------------------------------------------------------------------------
# 1. Google Apps Script Web App URL (sends natively via personal Gmail over HTTPS port 443)
GMAIL_RELAY_URL=

# 2. Brevo API Key (300 free emails/day over HTTPS port 443)
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Gmail App Password supported)
# ------------------------------------------------------------------------------
# SMTP server host (e.g. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP port: 587 for STARTTLS (recommended) or 465 for SSL
SMTP_PORT=587

# SMTP username (e.g. your full Gmail address)
SMTP_USER=you@gmail.com

# SMTP password (for Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords)
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Sender name and email address appearing in the From header
SMTP_FROM="Your Name via Work Reporter <you@gmail.com>"
